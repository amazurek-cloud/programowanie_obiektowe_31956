<Window x:Class="HomeLibrary.UI.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj książkę"
        Height="420"
        Width="400"
        WindowStartupLocation="CenterOwner">

    <!-- UI – interfejs użytkownika -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Tytuł:" FontWeight="Bold"/>
            <TextBox x:Name="TitleBox" Margin="0,0,0,10"/>

            <TextBlock Text="Imię autora:" FontWeight="Bold"/>
            <TextBox x:Name="FirstNameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Nazwisko autora:" FontWeight="Bold"/>
            <TextBox x:Name="LastNameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Gatunek:" FontWeight="Bold"/>
            <ComboBox x:Name="GenreBox" Margin="0,0,0,10"/>

            <TextBlock Text="Ocena (1–5):" FontWeight="Bold"/>
            <TextBox x:Name="RatingBox" Margin="0,0,0,10"/>

            <TextBlock Text="Komentarz:" FontWeight="Bold"/>
            <TextBox x:Name="CommentBox"
                     Margin="0,0,0,10"
                     TextWrapping="Wrap"/>

            <CheckBox x:Name="ReadCheck"
                      Content="Przeczytana"
                      Margin="0,10,0,0"/>

        </StackPanel>

        <Button Grid.Row="1"
                Content="Zapisz"
                HorizontalAlignment="Right"
                Width="100"
                Margin="0,10,0,0"
                Click="Save_Click"/>
    </Grid>
</Window>