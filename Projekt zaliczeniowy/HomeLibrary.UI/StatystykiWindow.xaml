<Window x:Class="HomeLibrary.UI.StatystykiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statystyki biblioteki"
        Height="300" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Statystyki biblioteki"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock x:Name="ReadCountText"
                       FontSize="16"
                       Margin="0 10"/>

            <TextBlock x:Name="UnreadCountText"
                       FontSize="16"
                       Margin="0 10"/>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 10">
                <TextBlock Text="Gatunek:"
                           VerticalAlignment="Center"
                           Margin="0 0 10 0"/>
                <ComboBox x:Name="GenreComboBox"
                          Width="180"
                          SelectedIndex="0"/>
            </StackPanel>

            <TextBlock x:Name="GenreCountText"
                       FontSize="16"
                       Margin="0 10"/>

        </StackPanel>
    </Grid>
</Window>