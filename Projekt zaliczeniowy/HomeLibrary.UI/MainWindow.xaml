<Window x:Class="HomeLibrary.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home Library" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10" Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Text="Home Library"
                   FontSize="24"
                   FontWeight="Bold"
                   Grid.Row="0"
                   Margin="0,0,0,10"/>

        <!-- Lista książek -->
        <ListBox x:Name="BooksList"
                 Grid.Row="1"
                 Margin="0,10,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>

                        <!-- Tytuł -->
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                        <!-- Autor -->
                        <TextBlock Text="Autor:" 
                                   FontWeight="SemiBold" 
                                   Margin="0,4,0,0"/>

                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="AuthorFirstName"/>
                                    <Binding Path="AuthorLastName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- Komentarz -->
                        <TextBlock Text="Komentarz:" 
                                   FontWeight="SemiBold" 
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding Comment}"
                                   Foreground="DarkSlateGray"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Przyciski -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Dodaj książkę"
                    Width="120"
                    Margin="5"
                    Click="AddBook_Click"/>

            <Button Content="Oznacz jako przeczytaną"
                    Width="170"
                    Margin="5"
                    Click="MarkRead_Click"/>

            <Button Content="Zapisz do JSON"
                    Width="120"
                    Margin="5"
                    Click="Save_Click"/>

            <Button Content="Szczegóły"
                    Width="120"
                    Margin="5"
                    Click="Details_Click"/>
            <Button Content="Statystyki"
                    Width="120"
                    Margin="5"
                    Click="Stats_Click"/>

        </StackPanel>

    </Grid>
</Window>